rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function sharedStoreId() {
      return '99mallbrahmpur';
    }

    function isAllowedEmail() {
      return request.auth != null
        && request.auth.token.email in [
          'sumiitkumar.it@gmail.com',
          'amiitkumar.it@gmail.com'
        ];
    }

    match /accounts/{uid} {
      allow read: if isAllowedEmail()
        && request.auth.uid == uid;
      allow create: if isAllowedEmail()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'ownerId', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'ownerId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.ownerId == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp;
    }

    match /sales/{saleId} {
      allow read: if isAllowedEmail();
      allow create: if isAllowedEmail()
        && request.resource.data.keys().hasOnly([
          'ownerId', 'id', 'billNumber', 'quantity', 'unitPrice',
          'manualAmount', 'total', 'date', 'time', 'createdAt', 'remarks'
        ])
        && request.resource.data.keys().hasAll([
          'ownerId', 'id', 'billNumber', 'quantity', 'unitPrice',
          'manualAmount', 'total', 'date', 'time', 'createdAt'
        ])
        && request.resource.data.ownerId == sharedStoreId()
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 60
        && request.resource.data.billNumber == request.resource.data.id
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.unitPrice is int
        && request.resource.data.unitPrice > 0
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.manualAmount is bool
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.createdAt is timestamp
        && (
          (
            request.resource.data.manualAmount == true
            && request.resource.data.quantity == 1
            && request.resource.data.unitPrice == request.resource.data.total
            && request.resource.data.keys().hasAll(['remarks'])
            && request.resource.data.remarks is string
            && request.resource.data.remarks.size() > 0
            && request.resource.data.remarks.size() <= 300
          )
          || (
            request.resource.data.manualAmount == false
            && request.resource.data.unitPrice == 99
            && request.resource.data.total == request.resource.data.quantity * 99
            && !request.resource.data.keys().hasAny(['remarks'])
          )
        );
      allow update: if isAllowedEmail()
        && request.resource.data.ownerId == sharedStoreId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId']);
      allow delete: if isAllowedEmail();
    }

    match /expenses/{expenseId} {
      allow read: if isAllowedEmail();
      allow create: if isAllowedEmail()
        && request.resource.data.keys().hasOnly([
          'ownerId', 'amount', 'category', 'date', 'description', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerId', 'amount', 'category', 'date', 'description', 'createdAt'
        ])
        && request.resource.data.ownerId == sharedStoreId()
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 100
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.createdAt is timestamp;
      allow update: if isAllowedEmail()
        && request.resource.data.ownerId == sharedStoreId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId']);
      allow delete: if isAllowedEmail();
    }

    match /goldmedal_sales/{saleId} {
      allow read: if isAllowedEmail();
      allow create: if isAllowedEmail()
        && request.resource.data.keys().hasOnly([
          'ownerId', 'id', 'billNumber', 'total', 'date', 'time', 'remarks', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerId', 'id', 'billNumber', 'total', 'date', 'time', 'remarks', 'createdAt'
        ])
        && request.resource.data.ownerId == sharedStoreId()
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 60
        && request.resource.data.billNumber == request.resource.data.id
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.remarks is string
        && request.resource.data.remarks.size() > 0
        && request.resource.data.remarks.size() <= 300
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isAllowedEmail();
    }
  }
}
