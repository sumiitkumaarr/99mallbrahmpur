rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedEmail() {
      return request.auth != null
        && request.auth.token.email in [
          'sumiitkumar.it@gmail.com',
          'amiitkumar.it@gmail.com'
        ];
    }

    match /accounts/{uid} {
      allow read: if isAllowedEmail()
        && request.auth.uid == uid;
      allow create: if isAllowedEmail()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'ownerId', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'ownerId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.ownerId == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp;
    }

    match /sales/{saleId} {
      allow read, write: if isAllowedEmail();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAllowedEmail();
    }

    match /goldmedal_sales/{saleId} {
      allow read, write: if isAllowedEmail();
    }

    match /bill_counters/{counterId} {
      allow read, write: if isAllowedEmail();
    }
  }
}
